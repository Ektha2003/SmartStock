# ==========================================
# SMARTSTOCK BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Database Configuration (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=smartstock_db;Username=postgres;Password=Admin@123;Include Error Detail=true

# JWT Authentication
Jwt__Secret=SmartStockSuperSecureJwtSigningKeyForHackathon2026WithSufficientLength!
Jwt__Issuer=SmartStockAPI
Jwt__Audience=SmartStockClient
Jwt__AccessTokenExpirationMinutes=1440
Jwt__RefreshTokenExpirationDays=7

# Google Gemini AI Integration
Gemini__ApiKey=your_gemini_api_key_here
Gemini__Model=gemini-3.8-flash

# Gmail / SMTP Email Configuration
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=your_store_email@gmail.com
Email__SmtpPassword=your_gmail_app_password_here
Email__FromEmail=orders@smartstock.local
Email__FromName=SmartStock Grocery Delivery
Email__EnableSsl=true
Email__GmailClientId=
Email__GmailClientSecret=
Email__GmailRefreshToken=

# Frontend CORS Origin
Frontend__Origin=http://localhost:5173;http://localhost:3000
